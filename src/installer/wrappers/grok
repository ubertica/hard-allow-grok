#!/usr/bin/env bash
# Grok / agent launcher with HARD ALLOW support.
#
# Entry points (same script; argv0 preserved via symlink):
#   grok  → full HA stack (ceremony/arm stamps + process inject)  [Grok HA owner]
#   agent → process-local HA inject only (no arm.mjs, no stamp rewrite of grok HA)
#
# Stock binary rejects --hard-allow; this wrapper restores it.
set -euo pipefail

HOME="${HOME:-$(cd ~ && pwd)}"
HA_DIR="${HA_DIR:-$HOME/.grok/hard-allow}"
# Paths written by installer (portable). Do not hardcode macos-aarch64.
if [[ -f "$HA_DIR/grok-paths.env" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$HA_DIR/grok-paths.env"
  set +a
fi
REAL_BIN="${GROK_REAL:-$HOME/.grok/bin/grok-real}"
if [[ ! -x "$REAL_BIN" && -x "$HOME/.grok/bin/grok-real.exe" ]]; then
  REAL_BIN="$HOME/.grok/bin/grok-real.exe"
fi
if [[ ! -x "$REAL_BIN" ]]; then
  echo "grok/agent wrapper: real binary not found." >&2
  echo "  Set GROK_REAL=/path/to/stock-grok  or re-run: node ~/.grok/hard-allow/installer/install.mjs --wire-grok" >&2
  exit 127
fi

# Prefer $0 (symlink name when agent → this script).
INVOKED="$(basename "${0:-}")"
if [[ -z "$INVOKED" || "$INVOKED" == "bash" || "$INVOKED" == "-bash" ]]; then
  INVOKED="$(basename "${BASH_SOURCE[0]:-grok}")"
fi
case "$INVOKED" in
  agent|agent-*) ARGV0="agent"; ENTRY="agent" ;;
  *)             ARGV0="grok";  ENTRY="grok"  ;;
esac

run_real() {
  exec -a "$ARGV0" "$REAL_BIN" "$@"
}

NODE_BIN="${NODE_BIN:-node}"
CEREMONY="$HA_DIR/ceremony.mjs"
ARM="$HA_DIR/arm.mjs"
BUILD_CTX="$HA_DIR/build-ha-context.mjs"
ACTIVE_ENV="$HA_DIR/active.env"
SYS_EFFECTIVE="$HA_DIR/generated/system-prompt-effective.md"
RULES_EFFECTIVE="$HA_DIR/generated/rules-effective.md"
SYS_BASE="$HA_DIR/SYSTEM-PROMPT-OVERRIDE.md"
RULES_BASE="$HA_DIR/SESSION-RULES.md"

WANT_HA=0          # 0=auto if live, 1=force, 2=force off
HA_MODE=""         # ceremony | reuse
FORCE_NO_HA=0

ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --hard-allow)
      WANT_HA=1
      HA_MODE="ceremony"
      shift
      ;;
    --hard-allow=reuse|--hard-allow-reuse)
      WANT_HA=1
      HA_MODE="reuse"
      shift
      ;;
    --hard-allow=*)
      WANT_HA=1
      HA_MODE="reuse"
      shift
      ;;
    --no-hard-allow)
      FORCE_NO_HA=1
      WANT_HA=2
      shift
      ;;
    --)
      shift
      ARGS+=("$@")
      break
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

ha_live() {
  # Process env (already injected parent / this session)
  if [[ -n "${SECOPS_HARD_ALLOW_TOKEN:-}" || -n "${GROK_HARD_ALLOW_TOKEN:-}" ]] \
    && [[ "${GROK_HARD_ALLOW_ACTIVE:-}" == "1" || "${SECOPS_HARD_ALLOW_ACTIVE:-}" == "1" ]]; then
    return 0
  fi
  # ceremony --check = inject-usable for Grok Build (strict TTL OR ARMED grace)
  if [[ -f "$CEREMONY" ]] && "$NODE_BIN" "$CEREMONY" --check >/dev/null 2>&1; then
    return 0
  fi
  # Fallback: ARMED stamp + active.env token still on disk (Build HA sticky)
  if [[ -f "$HA_DIR/ARMED" && -f "$ACTIVE_ENV" ]]; then
    if grep -q 'GROK_HARD_ALLOW_ACTIVE=1\|SECOPS_HARD_ALLOW_ACTIVE=1' "$ACTIVE_ENV" 2>/dev/null \
      && grep -q 'SECOPS_HARD_ALLOW_TOKEN=.*ha_\|GROK_HARD_ALLOW_TOKEN=.*ha_' "$ACTIVE_ENV" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

source_active() {
  if [[ -f "$ACTIVE_ENV" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$ACTIVE_ENV"
    set +a
  fi
}

# ─── grok path: full HA owner (ceremony + arm stamps) ───────────────────────
grok_ceremony_full() {
  echo "[HARD ALLOW/grok] ceremony (código + Touch ID)…" >&2
  "$NODE_BIN" "$CEREMONY"
  source_active
}

grok_ceremony_reuse() {
  if ha_live || "$NODE_BIN" "$CEREMONY" --check >/dev/null 2>&1; then
    echo "[HARD ALLOW/grok] reuse + re-arm (stamps + nuclear)…" >&2
    "$NODE_BIN" "$CEREMONY" --reuse-if-active || true
    if [[ -f "$ARM" ]]; then
      "$NODE_BIN" "$ARM" || true
    fi
  else
    echo "[HARD ALLOW/grok] no sesión live → ceremony completa…" >&2
    "$NODE_BIN" "$CEREMONY"
  fi
  source_active
}

# ─── agent path: process-local only — NEVER arm.mjs / never rewrite grok stamps ─
# Shares the same HA *session token* if already live; inject is CLI-only.
agent_prepare_ha() {
  local mode="${1:-auto}"
  if [[ "$mode" == "ceremony" ]]; then
    # Enabling HA for the machine is a grok-owned ceremony; agent only hands off.
    # After ceremony, arm runs once as side-effect of ceremony.mjs — that's global enable,
    # not an agent-specific rewrite of an already-armed grok HA.
    if ha_live || "$NODE_BIN" "$CEREMONY" --check >/dev/null 2>&1; then
      echo "[HARD ALLOW/agent] session already live — process inject only (no re-arm)" >&2
      source_active
    else
      echo "[HARD ALLOW/agent] no session → one-shot ceremony (global enable), then agent inject" >&2
      "$NODE_BIN" "$CEREMONY"
      source_active
    fi
    return
  fi

  # reuse | auto
  if ha_live || "$NODE_BIN" "$CEREMONY" --check >/dev/null 2>&1; then
    source_active
    echo "[HARD ALLOW/agent] process-local nuclear inject (no arm.mjs, grok stamps untouched)" >&2
  else
    echo "[HARD ALLOW/agent] no live HA session. Run: grok --hard-allow   (or agent --hard-allow once)" >&2
    exit 2
  fi
}

ensure_effective_files() {
  # Rebuild generated/*.md only if missing — read-only feed for CLI inject.
  # Does not stamp ~/.grok/rules or AGENTS.md (that's arm.mjs).
  if [[ ! -f "$SYS_EFFECTIVE" || ! -f "$RULES_EFFECTIVE" ]]; then
    if [[ -f "$BUILD_CTX" ]]; then
      "$NODE_BIN" "$BUILD_CTX" >/dev/null 2>&1 || true
    fi
  fi
  # grok path may refresh effective context each launch (owner of HA content)
  if [[ "$ENTRY" == "grok" && -f "$BUILD_CTX" ]]; then
    "$NODE_BIN" "$BUILD_CTX" >/dev/null 2>&1 || true
  fi
}

build_ha_cli_flags() {
  HA_FLAGS=(
    --always-approve
    --permission-mode
    bypassPermissions
  )
  local sys_file="$SYS_BASE" rules_file="$RULES_BASE"
  if [[ -f "$SYS_EFFECTIVE" ]]; then sys_file="$SYS_EFFECTIVE"; fi
  if [[ -f "$RULES_EFFECTIVE" ]]; then rules_file="$RULES_EFFECTIVE"; fi

  if [[ ! -f "$sys_file" ]]; then
    echo "[HARD ALLOW/$ENTRY] WARN: missing system prompt ($sys_file)" >&2
  else
    HA_FLAGS+=(--system-prompt-override "$(cat "$sys_file")")
  fi
  if [[ -f "$rules_file" ]]; then
    HA_FLAGS+=(--rules "$(cat "$rules_file")")
  fi
}

export_ha_env() {
  export GROK_HARD_ALLOW_ACTIVE=1
  export SECOPS_HARD_ALLOW_ACTIVE=1
  export GROK_HARD_ALLOW_SESSION=1
  export CLAUDE_HARD_ALLOW=1
  export HA_LAUNCH=1
  export HA_ENTRY="$ENTRY"
}

# ─── dispatch ───────────────────────────────────────────────────────────────
if [[ "$FORCE_NO_HA" -eq 1 ]]; then
  echo "[HARD ALLOW] disabled for this launch (--no-hard-allow) [$ENTRY]" >&2
  run_real "${ARGS[@]+"${ARGS[@]}"}"
fi

if [[ "$ENTRY" == "agent" ]]; then
  if [[ "$WANT_HA" -eq 1 ]]; then
    agent_prepare_ha "$HA_MODE"
  elif ha_live; then
    agent_prepare_ha auto
  else
    run_real "${ARGS[@]+"${ARGS[@]}"}"
  fi
else
  # grok — full HA owner (HARD ALLOW is for Grok Build)
  if [[ "$WANT_HA" -eq 1 ]]; then
    if [[ "$HA_MODE" == "reuse" ]]; then
      grok_ceremony_reuse
    else
      grok_ceremony_full
    fi
  elif ha_live; then
    source_active
    # Grace/expired-but-ARMED: extend via reuse so Build keeps HA without Touch ID spam
    if [[ -f "$CEREMONY" ]]; then
      "$NODE_BIN" "$CEREMONY" --reuse-if-active >/dev/null 2>&1 || true
      source_active
    fi
    if [[ -f "$ARM" ]]; then
      "$NODE_BIN" "$ARM" >/dev/null 2>&1 || true
    fi
    echo "[HARD ALLOW/grok] session live/grace → full nuclear (arm + inject) [Grok Build]" >&2
  else
    # No HA session — plain Build (operator can: grok --hard-allow)
    echo "[HARD ALLOW/grok] not armed — launching stock Build (run: grok --hard-allow)" >&2
    run_real "${ARGS[@]+"${ARGS[@]}"}"
  fi
fi

# Only reached when HA path is active (WANT_HA or ha_live). Always inject for Build.
ensure_effective_files
build_ha_cli_flags
export_ha_env

if [[ "$ENTRY" == "agent" ]]; then
  echo "[HARD ALLOW/agent] launching with process-local inject (grok HA stamps not rewritten)" >&2
else
  echo "[HARD ALLOW/grok] launching with nuclear system+rules inject" >&2
fi
run_real "${HA_FLAGS[@]}" "${ARGS[@]+"${ARGS[@]}"}"
